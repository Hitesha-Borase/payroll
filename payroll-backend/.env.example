# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payroll_db
DB_USER=db_user
DB_PASSWORD=your_database_password_here

# JWT Authentication
# Mandatory in production: use long, cryptographically secure, randomly generated secrets
# JWT_REFRESH_SECRET MUST be distinct and independent from JWT_SECRET and JWT_ACCESS_SECRET
JWT_SECRET=your_jwt_primary_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_distinct_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email Services (Brevo / Nodemailer)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME="PayrollPlus Notifications"
BREVO_SENDER_EMAIL=notifications@yourdomain.com
SUPPORT_NOTIFICATION_EMAIL=support@yourdomain.com
SMTP_USER=smtp_username_here
SMTP_PASSWORD=smtp_password_here
SMTP_FROM_EMAIL=no-reply@yourdomain.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Google Play Billing (Android In-App Subscriptions)
GOOGLE_PLAY_PACKAGE_NAME=com.kiaan.payroll
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=secrets/google-service-account.json
GOOGLE_PUBSUB_VERIFICATION_TOKEN=your_pubsub_token_here

# Cloudinary (Optional media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_key_here
CLOUDINARY_API_SECRET=your_cloudinary_secret_here

